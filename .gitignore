# ==========================================
# 1. 点文件与白名单策略 (Dotfiles & Whitelist Strategy)
# ==========================================

# 默认忽略所有以点 (.) 开头的文件/文件夹 (黑名单机制)
.*

# 显式白名单：允许提交的关键配置文件与目录
!.gitignore
!.github/
!.editorconfig
!.nvmrc
!.npmrc

# ==========================================
# 2. 原始资料与构建输出隔离 (Input & Build Isolation)
# ==========================================

# 原始资料目录 (不参与 Git 跟踪与网页生成)
input/

# 参赛资料目录 (本地记录，不参与 Git 跟踪与网页生成)
docs/competition/

# Eleventy 缓存与编译输出目录
.cache/
dist/

# Node 依赖包目录
node_modules/

# ==========================================
# 3. 系统、日志与本地配置 (System, Logs & Local Configs)
# ==========================================
Thumbs.db

# 日志与调试文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 本地环境变量与配置文件
.env
.env.local
.env.*.local

# IDE 专有项目配置文件
*.iml
*.ipr
*.iws
